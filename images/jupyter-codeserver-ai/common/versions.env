# shellcheck shell=bash
# shellcheck disable=SC2034  # every pin here is consumed by definition files and
# the shared recipe that source this file, not by this file itself
# Every pinned version for the jupyter-codeserver-ai image family, in one place.
#
# Both definition files and the shared recipe read this. A version hardcoded in a
# definition file is a defect: it can drift from the other image and break the
# parity guarantee that replaces a shared base image.
#
# Bumping anything here requires rebuilding BOTH images, because the governance
# files are validated against the pinned CLI versions.

# Base images. Exact tags, never `latest`. The lab- tag pins Python, conda and
# JupyterLab coherently in one identifier.
JUPYTER_BASE_TAG="lab-4.6.3"
UBUNTU_TAG="24.04"

# Node supplies both AI CLIs. Taken from nodejs.org rather than NodeSource, which
# is unreachable from the build environment.
NODE_VERSION="24.20.0"

# AI CLIs. Both floors are load-bearing, not cosmetic:
#   Codex < 0.138.0 IGNORES allowed_permission_profiles and managed
#   default_permissions, which removes the restriction rather than degrading it.
#   Claude Code < 2.1.223 does not merge `env` per variable across administrative
#   sources, so DISABLE_AUTOUPDATER in the managed file would not apply when a
#   remote source wins selection.
CLAUDE_CODE_VERSION="2.1.248"
CODEX_VERSION="0.150.1"

# code-server. Published for linux-amd64 and linux-arm64.
CODE_SERVER_VERSION="4.135.0"

# Environment managers, image-owned for provisioning and staff maintenance.
UV_VERSION="0.12.7"
MICROMAMBA_VERSION="2.9.0"
