# shellcheck shell=bash
# shellcheck disable=SC2034  # every pin here is consumed by definition files and
# the shared recipe that source this file, not by this file itself
# Every pinned version for the jupyter-codeserver-ai image family, in one place.
#
# Both definition files and the shared recipe read this. A version hardcoded in a
# definition file is a defect: it can drift from the other image and break the
# parity guarantee that replaces a shared base image.
#
# Bumping anything here requires rebuilding BOTH images, because the governance
# files are validated against the pinned CLI versions.

# Base images. Exact tags, never `latest`. The lab- tag pins Python, conda and
# JupyterLab coherently in one identifier.
JUPYTER_BASE_TAG="lab-4.6.3"
UBUNTU_TAG="24.04"

# Node supplies both AI CLIs. Taken from nodejs.org rather than NodeSource, which
# is unreachable from the build environment.
NODE_VERSION="24.20.0"

# AI CLIs. Both floors are load-bearing, not cosmetic:
#   Codex < 0.138.0 IGNORES allowed_permission_profiles and managed
#   default_permissions, which removes the restriction rather than degrading it.
#   Claude Code < 2.1.223 does not merge `env` per variable across administrative
#   sources, so DISABLE_AUTOUPDATER in the managed file would not apply when a
#   remote source wins selection.
CLAUDE_CODE_VERSION="2.1.248"
CODEX_VERSION="0.150.1"

# code-server. Published for linux-amd64 and linux-arm64.
CODE_SERVER_VERSION="4.135.0"

# Environment managers, image-owned for provisioning and staff maintenance.
UV_VERSION="0.12.7"
MICROMAMBA_VERSION="2.9.0"

# Open VSX extensions, pinned together with code-server. Both publish
# per-platform builds and NO universal build, so the definition selects
# linux-<arch> explicitly -- an unqualified request resolves to alpine-arm64,
# a musl build that cannot run in these glibc images.
#
# Note the Codex extension is published as openai.chatgpt, not openai.codex.
# Engine requirements are ^1.94.0 and ^1.96.2; code-server 4.135.0 bundles
# Code 1.135.0, which satisfies both.
CLAUDE_EXT_ID="Anthropic.claude-code"
CLAUDE_EXT_VERSION="2.1.248"
CODEX_EXT_ID="openai.chatgpt"
CODEX_EXT_VERSION="26.5820.80927"

# The course-requested editor extensions. Unlike the two AI extensions above,
# all three publish a single UNIVERSAL build rather than per-platform ones, so
# they are fetched from the unqualified URL and the definition selects the form
# per extension. Engine requirements are ^1.95.0, ^1.105.0 and ^1.95.0;
# code-server 4.135.0 bundles Code 1.135.0, which satisfies all three.
#
# ms-python.python is load-bearing rather than convenience: it is the extension
# that reads python.defaultInterpreterPath, which the launcher generates per
# session. Without it that setting is inert.
PYTHON_EXT_ID="ms-python.python"
PYTHON_EXT_VERSION="2026.4.0"
JUPYTER_EXT_ID="ms-toolsai.jupyter"
JUPYTER_EXT_VERSION="2025.9.1"
RENDERERS_EXT_ID="ms-toolsai.jupyter-renderers"
RENDERERS_EXT_VERSION="1.3.0"

# JupyterLab server and front-end extensions the courses asked for, installed
# into the image because they extend the SERVER process -- the course
# environment owns only what a notebook imports.
#
# jupyterlab_widgets is the front-end half of ipywidgets. Both course
# environments list ipywidgets for the kernel side; without this package its
# widget output renders as nothing.
#
# notebook-intelligence is pip-only and floors at 5.3.1 per both course
# requests. It warns about JupyterLab 4.6 compatibility; both requesters tested
# it, confirmed it works, and explicitly asked that JupyterLab NOT be pinned
# back to silence the warning.
NOTEBOOK_INTELLIGENCE_FLOOR="5.3.1"

# notebook-intelligence 5.3.1 declares `mcp>=1.28.1` with NO upper bound, but
# imports `mcp.server.fastmcp`, which mcp 2.x removed (FastMCP was renamed to
# MCPServer). Left unconstrained, pip resolves mcp 2.x and the extension cannot
# be imported at all -- JupyterLab starts and the extension is simply dead. The
# ceiling is ours to carry until upstream bounds its own dependency; the only
# stable release is 5.3.1, so there is no newer version to move to.
MCP_CONSTRAINT="mcp<2"
