Bootstrap: docker
From: ubuntu:24.04
# The same distribution and release the Jupyter base is built on, so the shared
# recipe runs in an identical environment in both images. Pinned in
# common/versions.env as UBUNTU_TAG.

%files
    common/versions.env             /opt/build/versions.env
    common/install-ai-agents.sh     /opt/build/install-ai-agents.sh
    common/claude-code              /opt/build/claude-code
    common/codex                    /opt/build/codex
    codeserver/settings.json        /opt/build/settings.json

%post -c /bin/bash
    set -euo pipefail
    . /opt/build/versions.env

    # python3 here is for JSON validation and small tooling only. This image
    # deliberately carries no Jupyter runtime.
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends python3 xz-utils curl ca-certificates
    rm -rf /var/lib/apt/lists/*

    case "$(uname -m)" in
        x86_64)  CS_ARCH=amd64 ;;
        aarch64) CS_ARCH=arm64 ;;
        *) echo "ERROR: unsupported architecture $(uname -m)" >&2; exit 1 ;;
    esac

    CS_TARBALL="code-server-${CODE_SERVER_VERSION}-linux-${CS_ARCH}.tar.gz"
    curl -fsSL -o "/opt/build/${CS_TARBALL}" \
        "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/${CS_TARBALL}"
    mkdir -p /usr/local/lib/code-server
    tar -xzf "/opt/build/${CS_TARBALL}" -C /usr/local/lib/code-server --strip-components=1
    ln -sf /usr/local/lib/code-server/bin/code-server /usr/local/bin/code-server

    # The immutable, image-owned extensions directory. The launcher always passes
    # --extensions-dir=/opt/code-server/extensions alongside
    # --user-data-dir=/state/code-server. The two must never be combined: pointing
    # --extensions-dir at /state would hide these image-owned extensions.
    install -d -m 0755 /opt/code-server/extensions

    # Seed machine settings. The launcher copies these into the job-local
    # user-data directory and adds the course interpreter path, which cannot be
    # baked into a shared image.
    install -d -m 0755 /etc/code-server
    install -m 0644 /opt/build/settings.json /etc/code-server/settings.json

    # Extensions, by explicit platform target. An unqualified request resolves
    # to alpine-arm64; these images are glibc. Each download is verified against
    # the checksum Open VSX publishes beside it.
    case "$(uname -m)" in
        x86_64)  EXT_PLAT=linux-x64   ;;
        aarch64) EXT_PLAT=linux-arm64 ;;
    esac

    install -d -m 0755 /etc/ood-ai
    for spec in "${CLAUDE_EXT_ID}:${CLAUDE_EXT_VERSION}" "${CODEX_EXT_ID}:${CODEX_EXT_VERSION}"; do
        ext_id="${spec%%:*}"
        ext_ver="${spec##*:}"
        ns="${ext_id%%.*}"
        nm="${ext_id#*.}"
        base="https://open-vsx.org/api/${ns}/${nm}/${EXT_PLAT}/${ext_ver}/file/${ext_id}-${ext_ver}@${EXT_PLAT}"
        vsix="/opt/build/${ext_id}-${ext_ver}.vsix"

        curl -fsSL -o "${vsix}" "${base}.vsix"
        curl -fsSL -o "${vsix}.sha256" "${base}.sha256"
        # The published .sha256 contains the bare digest, so compose the line
        # sha256sum -c expects rather than assuming its format.
        echo "$(cat "${vsix}.sha256")  ${vsix}" | sha256sum -c -

        code-server \
            --extensions-dir /opt/code-server/extensions \
            --install-extension "${vsix}"
    done

    # Record each extension's marketplace version, from its package.json.
    for d in /opt/code-server/extensions/*/; do
        [ -f "${d}package.json" ] || continue
        nm=$(basename "$d")
        ver=$(python3 -c "import json;print(json.load(open('${d}package.json')).get('version','unknown'))")
        echo "extension_${nm}=${ver}"
    done > /opt/build/extension-manifest.txt

    # The versions above describe the extension PACKAGE. The Codex extension
    # also ships its OWN codex CLI binary, and it legitimately differs from the
    # system CLI -- the extension has shipped a prerelease while the pin was on
    # a stable release. That bundled binary is what the extension actually runs,
    # so the Codex policy floor applies to it in its own right and the spec
    # requires it be inventoried SEPARATELY, under its own manifest key.
    #
    # Its version is only knowable by executing it: nothing in the vsix records
    # it. The bin directory is named for the kernel architecture (linux-aarch64,
    # linux-x64), which is not the platform token used to fetch the vsix, so
    # locate it rather than composing the path.
    embedded_codex=$(find /opt/code-server/extensions -type f -name codex -path '*/bin/*' | head -1)
    if [ -z "${embedded_codex}" ]; then
        echo "ERROR: the Codex extension shipped no bundled codex binary" >&2
        exit 1
    fi
    if [ ! -x "${embedded_codex}" ]; then
        echo "ERROR: the bundled codex binary is not executable: ${embedded_codex}" >&2
        exit 1
    fi
    # A plain assignment, with no stderr suppression: if the binary cannot run,
    # set -e aborts the build loudly instead of recording a blank field.
    embedded_codex_version=$("${embedded_codex}" --version)
    echo "extension_embedded_codex=${embedded_codex_version}" \
        >> /opt/build/extension-manifest.txt

    # LAST: the recipe removes /opt/build when it finishes.
    bash /opt/build/install-ai-agents.sh

%environment
    export PATH=/usr/local/bin:$PATH

%labels
    org.harvard.atg.family jupyter-codeserver-ai
    org.harvard.atg.app    codeserver

%help
    code-server with Claude Code and Codex preinstalled, for HUIT OOD course
    apps. Launched by the ood-codeserver-ai Open OnDemand app.
