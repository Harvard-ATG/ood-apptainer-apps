Bootstrap: docker
From: alpine:3.20

%post -c /bin/sh
  echo stub > /opt/marker

  # The real app images are Debian-based and have bash; the in-container
  # launchers use `#!/usr/bin/env bash`. The stub must match or it cannot
  # execute them at all.
  apk add --no-cache bash

  # Shim standing in for a real server. Records argv and PID, then holds a
  # listening socket so OOD readiness checks succeed.
  cat > /usr/local/bin/_stub-server <<'SHIM'
#!/bin/sh
# $0 is the name the launcher invoked (jupyter or code-server).
: "${STATE_DIR:=/state}"
mkdir -p "$STATE_DIR"
printf '%s\n' "$0" "$@" > "$STATE_DIR/argv.log"
printf '%s\n' "$$" > "$STATE_DIR/server.pid"
printf '%s\n' "$PPID" > "$STATE_DIR/server.ppid"
env > "$STATE_DIR/env.log"
: "${STUB_PORT:=${MY_JUP_PORT:-${CODE_SERVER_PORT:-8888}}}"
while :; do
    nc -l -p "$STUB_PORT" >/dev/null 2>&1 || sleep 1
done
SHIM
  chmod 755 /usr/local/bin/_stub-server
  ln -s /usr/local/bin/_stub-server /usr/local/bin/jupyter
  ln -s /usr/local/bin/_stub-server /usr/local/bin/code-server

  # The real JupyterLab image keeps jupyter at /opt/conda/bin and deliberately
  # keeps that directory OFF the container PATH, so the in-container launcher
  # execs the absolute path. Mirror that layout here or the launcher cannot
  # start against the stub either.
  mkdir -p /opt/conda/bin
  ln -s /usr/local/bin/_stub-server /opt/conda/bin/jupyter

  # The real JupyterLab image ships its own interpreter at /opt/conda/bin/python,
  # which backs the fallback kernel. The stub only needs the path to exist and
  # to be executable -- nothing in these tests runs it.
  printf '#!/bin/sh\nexit 0\n' > /opt/conda/bin/python
  chmod 755 /opt/conda/bin/python
