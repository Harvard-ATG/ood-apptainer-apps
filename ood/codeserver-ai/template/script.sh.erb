#!/usr/bin/env bash
# Host-side launch. Forked by OOD as a child process, NOT exec'd: OOD records
# this script's pid as SCRIPT_PID and after.sh reaps with pkill -P.

# shellcheck disable=SC2154,SC1091
# SC2154: $port, $password and the MY_JUP_* values are provided by before.sh.erb,
# which OOD sources into the same shell before running this script. shellcheck
# lints this file in isolation and cannot see them.
# SC1091: the shared library is sourced from ${JOBROOT}/lib/, a path that exists
# only in the staged session directory at run time, so it can never resolve at lint
# time. The canonical copy is linted directly as ood/lib/launch-common.sh.

set -uo pipefail

this_script="template/script.sh.erb"

log() {
    echo -e "[$(date -Iseconds)][${this_script}] $1"
}

# shellcheck source=../../lib/launch-common.sh
. "${JOBROOT}/lib/launch-common.sh"

log "starting; HOME=${HOME}"
cd "${HOME}" || exit 1

IMAGE_FILE="<%= context.imagefile %>"
COURSE_FOLDER="<%= context.course_folder %>"
ENVIRONMENT_ROOT_RAW="<%= context.environment_root %>"

# environment_root is OPTIONAL. A blank one means the course wants no
# course-shared environment, and there is then no path to validate: passing the
# empty string to lc_validate_under resolves it against the current directory
# and fails the launch outright, which is the opposite of opting out.
if [ -n "${ENVIRONMENT_ROOT_RAW}" ]; then
    ENVIRONMENT_ROOT=$(lc_validate_under "${ENVIRONMENT_ROOT_RAW}" "${COURSE_FOLDER}") || exit 1
else
    ENVIRONMENT_ROOT=""
fi

# A missing course environment degrades the session and an unconfigured one is
# ordinary; only an escaping path is fatal. See lc_classify_course_env.
lc_classify_course_env "${ENVIRONMENT_ROOT}" "${COURSE_FOLDER}" bin/python || exit 1
COURSE_ENV="${LC_COURSE_ENV}"
COURSE_ENV_STATUS="${LC_COURSE_ENV_STATUS}"

# Overridable so the test suite can point the state layout at a fixture
# instead of the real /scratch. Every app shares this root -- job state is keyed
# by SLURM_JOB_ID and the caches are meant to be shared -- so it is named for
# the launch mechanism, not for any one image family.
SCRATCH_ROOT="${OOD_APPTAINER_SCRATCH_ROOT:-/scratch/$(id -nu)/ood/apptainer}"
JOB_STATE="${SCRATCH_ROOT}/jobs/${SLURM_JOB_ID}/state"
JOB_TMP="${SCRATCH_ROOT}/jobs/${SLURM_JOB_ID}/tmp"
SSH_MASK="${JOB_STATE}/ssh-mask"

lc_make_state_dirs \
    "${SCRATCH_ROOT}/workspaces" \
    "${SCRATCH_ROOT}/cache/xdg" \
    "${SCRATCH_ROOT}/cache/mamba" \
    "${SCRATCH_ROOT}/cache/uv" \
    "${JOB_STATE}/code-server" \
    "${JOB_STATE}/xdg/config" \
    "${JOB_STATE}/xdg/data" \
    "${JOB_TMP}" \
    "${SSH_MASK}" \
    "${HOME}/.claude" \
    "${HOME}/.codex" \
    "${HOME}/.config/gh" || { log "ERROR: could not create state directories"; exit 1; }

ENV_FILE="${JOBROOT}/container.env"
lc_write_env_file "${ENV_FILE}" \
    "ENVIRONMENT_ROOT=${ENVIRONMENT_ROOT}" \
    "COURSE_ENV=${COURSE_ENV}" \
    "COURSE_ENV_STATUS=${COURSE_ENV_STATUS}" \
    "CLAUDE_CONFIG_DIR=${HOME}/.claude" \
    "CODEX_HOME=${HOME}/.codex" \
    "GH_CONFIG_DIR=${HOME}/.config/gh" \
    "DISABLE_AUTOUPDATER=1" \
    "XDG_CONFIG_HOME=/state/xdg/config" \
    "XDG_DATA_HOME=/state/xdg/data" \
    "XDG_CACHE_HOME=${SCRATCH_ROOT}/cache/xdg" \
    "MAMBA_ROOT_PREFIX=${SCRATCH_ROOT}/cache/mamba" \
    "UV_CACHE_DIR=${SCRATCH_ROOT}/cache/uv" \
    "PYTHONNOUSERSITE=1" \
    "PATH=/usr/local/bin:/usr/bin:/bin" \
    "CODE_SERVER_PORT=${port}" \
    "PASSWORD=${password}" \
    || { log "ERROR: could not write the container environment file"; exit 1; }

CONTAINER_IMAGE=$(lc_select_image "${IMAGE_FILE}") || exit 1
APPTAINER_BIN=$(lc_apptainer_bin) || exit 1
log "apptainer=${APPTAINER_BIN}"

# lc_validate_under uses realpath -m, which tolerates missing path components,
# and the course folder is only ever the root of a validation, never the
# target -- so nothing above catches an absent course folder. Without this
# check, a missing course folder surfaces 600 seconds later as an opaque
# Apptainer bind error instead of a clear message at launch.
if [ ! -d "${COURSE_FOLDER}" ] || [ ! -r "${COURSE_FOLDER}" ]; then
    log "ERROR: course folder not found or not readable: ${COURSE_FOLDER}"
    exit 1
fi

lc_build_binds "${COURSE_FOLDER}" "${SCRATCH_ROOT}" "${JOB_STATE}" "${JOB_TMP}" "${SSH_MASK}"
log "binds=${LC_BINDS[*]}"

log "launching code-server"
lc_run "${APPTAINER_BIN}" "${CONTAINER_IMAGE}" "${ENV_FILE}" "${JOBROOT}/codeserver.script.sh"
status=$?
log "apptainer exited with status ${status}"
exit "${status}"
